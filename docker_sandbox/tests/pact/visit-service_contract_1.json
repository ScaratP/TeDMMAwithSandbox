{
  "consumer": {
    "name": "api-gateway"
  },
  "provider": {
    "name": "visit-service"
  },
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "interactions": [
    {
      "description": "Get all visits",
      "request": {
        "method": "get",
        "path": "/visits"
      },
      "response": {
        "status": 200,
        "body": [
          {
            "id": 1,
            "date": "2023-10-01",
            "description": "Check-up"
          }
        ]
      },
      "providerStates": [
        {
          "name": "Visits exist"
        }
      ]
    },
    {
      "description": "Get visit by ID",
      "request": {
        "method": "get",
        "path": "/visits/1"
      },
      "response": {
        "status": 200,
        "body": {
          "id": 1,
          "date": "2023-10-01",
          "description": "Check-up"
        }
      },
      "providerStates": [
        {
          "name": "Visit with ID 1 exists"
        }
      ]
    },
    {
      "description": "Create a new visit",
      "request": {
        "method": "post",
        "path": "/visits",
        "body": {
          "date": "2023-10-01",
          "description": "Check-up"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": 1,
          "date": "2023-10-01",
          "description": "Check-up"
        }
      },
      "providerStates": [
        {
          "name": "Ready to create a visit"
        }
      ]
    },
    {
      "description": "Update an existing visit",
      "request": {
        "method": "put",
        "path": "/visits/1",
        "body": {
          "date": "2023-10-02",
          "description": "Follow-up"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": 1,
          "date": "2023-10-02",
          "description": "Follow-up"
        }
      },
      "providerStates": [
        {
          "name": "Visit with ID 1 exists"
        }
      ]
    },
    {
      "description": "Delete a visit",
      "request": {
        "method": "delete",
        "path": "/visits/1"
      },
      "response": {
        "status": 204
      },
      "providerStates": [
        {
          "name": "Visit with ID 1 exists"
        }
      ]
    }
  ]
}
